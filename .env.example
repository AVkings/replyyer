# Repllyer — Environment Variables Template
# Copy this file to .env.local and fill in your keys
# NEVER commit .env.local to git

# ──────────────────────────────────────────────
# Supabase (from https://supabase.com/dashboard/project/_/settings/api)
# ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.YOUR_SERVICE_ROLE_KEY

# ──────────────────────────────────────────────
# Kira AI — OpenAI-compatible endpoint
# Docs: https://kiraai.vn
# ──────────────────────────────────────────────
KIRA_API_KEY=sk-kira-YOUR_API_KEY_HERE
KIRA_BASE_URL=https://kiraai.vn/api/v1
# Model used for chat + embeddings
KIRA_MODEL=hy3

# ──────────────────────────────────────────────
# GoFile.io — File storage for attachments
# Get token from https://gofile.io/myProfile
# ──────────────────────────────────────────────
GOFILE_API_TOKEN=YOUR_GOFILE_API_TOKEN
# Optional: folder ID for `repllyer` parent folder (created automatically if empty)
GOFILE_FOLDER_ID=

# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://replyyer.vercel.app
